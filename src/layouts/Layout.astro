---
const title = Astro.props.title || "Darkvoid Studios — Estudio indie en Lima, Perú";
const description = Astro.props.description || "Darkvoid Studios es un estudio indie de videojuegos en Lima, Perú. Creadores de A.N.A. — The Broken Link, 2.º mejor juego de Latinoamérica en GameJamPlus 25/26.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL("/og-ana.jpg", Astro.site);
const ogImageWidth = 1280;
const ogImageHeight = 720;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="describedby" href="/llms.txt" type="text/markdown" />
    <meta name="author" content="Darkvoid Studios" />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="dark" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Darkvoid Studios" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="A.N.A. — The Broken Link, de Darkvoid Studios" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="A.N.A. — The Broken Link, de Darkvoid Studios" />

    <meta name="theme-color" content="#050505" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": new URL("/#studio", Astro.site).toString(),
          "name": "Darkvoid Studios",
          "url": Astro.site?.toString(),
          "logo": new URL("/assets/studio/dark-void-logo.jpg", Astro.site).toString(),
          "location": { "@type": "Place", "name": "Lima, Perú" },
          "sameAs": [
            "https://darkvvoidstudios.itch.io/",
            "https://darkvvoidstudios.itch.io/ana",
            "https://discord.gg/3nMe29jHzn",
            "https://www.instagram.com/darkvoidgames/",
            "https://github.com/Dark-Void-Studio"
          ]
        },
        {
          "@type": "WebSite",
          "@id": new URL("/#website", Astro.site).toString(),
          "url": Astro.site?.toString(),
          "name": "Darkvoid Studios",
          "inLanguage": "es",
          "publisher": { "@id": new URL("/#studio", Astro.site).toString() }
        },
        {
          "@type": "VideoGame",
          "@id": new URL("/#game", Astro.site).toString(),
          "name": "A.N.A. — The Broken Link",
          "description": description,
          "image": ogImageURL.toString(),
          "url": canonicalURL.toString(),
          "genre": ["Action", "Beat 'em up", "Cyberpunk", "Anime"],
          "keywords": "25d, anime, cyberpunk, synthwave, beat em up, hack and slash, futuristic, artgame, darkvoid studios, dark void studios lima peru, ana the broken link dark void, indie, gamejamplus, segundo lugar mejor juego latam",
          "operatingSystem": "Windows",
          "applicationCategory": "Game",
          "playMode": "SinglePlayer",
          "isAccessibleForFree": true,
          "award": "2.º mejor juego de Latinoamérica — GameJamPlus 25/26",
          "datePublished": "2026-08-25",
          "dateModified": "2026-08-26",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD",
            "availability": "https://schema.org/InStock",
            "url": "https://darkvvoidstudios.itch.io/ana"
          },
          "author": [
            { "@type": "Organization", "name": "Darkvoid Studios", "url": "https://darkvvoidstudios.itch.io" },
            { "@type": "Person", "name": "PeryLoth" }
          ],
          "publisher": { "@id": new URL("/#studio", Astro.site).toString() },
          "inLanguage": "es",
          "sameAs": ["https://darkvvoidstudios.itch.io/ana"]
        }
      ]
    })} />
  </head>
  <body>
    <slot />
    <style is:global>
      html { color-scheme: dark; }
      ::selection { background: #00f0ff; color: #050505; }
    </style>
  </body>
</html>
