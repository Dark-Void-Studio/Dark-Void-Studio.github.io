    }
    .mobile-menu a:not(.btn) {
      display: flex; align-items: center; min-height: 56px;
      font-size: var(--t-md); font-weight: 700; font-variation-settings: "wdth" 118;
      text-decoration: none; border-bottom: 1px solid var(--rule);
    }
    .mobile-menu .btn { margin-top: 20px; width: 100%; }

    /* ---------- Hero ---------- */
    .hero {
      position: relative; overflow: hidden;
      min-height: 100svh;
      display: grid; align-items: center;
      padding: 120px 0 88px;
      isolation: isolate;
    }
    .starfield {
      position: absolute; inset: 0; z-index: -2; pointer-events: none;
      background-image:
        radial-gradient(1px 1px at 12% 18%, rgba(255,255,255,.7), transparent 60%),
        radial-gradient(1px 1px at 28% 72%, rgba(255,255,255,.45), transparent 60%),
        radial-gradient(1.5px 1.5px at 44% 12%, rgba(255,255,255,.6), transparent 60%),
        radial-gradient(1px 1px at 63% 84%, rgba(255,255,255,.4), transparent 60%),
        radial-gradient(1px 1px at 78% 22%, rgba(255,255,255,.55), transparent 60%),
        radial-gradient(1.5px 1.5px at 91% 64%, rgba(255,255,255,.5), transparent 60%),
        radial-gradient(1px 1px at 6% 88%, rgba(255,255,255,.35), transparent 60%),
        radial-gradient(1px 1px at 52% 46%, rgba(255,255,255,.3), transparent 60%),
        radial-gradient(1px 1px at 36% 34%, rgba(255,255,255,.4), transparent 60%),
