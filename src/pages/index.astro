<script is:inline>
    // Placa de la semifinal en 3D. La geometría del archivo .glb va incrustada (23 KB) y la textura
    // se carga como un JPG normal, así no hace falta pedir datos "data:" o "blob:" que algunos hosts bloquean.
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

    const GEOMETRY_GLB = '';
    const stage = document.querySelector('.trophy-stage--3d');
    const canvas = stage?.querySelector('.trophy-canvas');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const start = () => {
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'low-power' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(28, 1, 0.01, 100);
      scene.add(new THREE.AmbientLight(0xffffff, 1.4));
      const key = new THREE.DirectionalLight(0xffffff, 2.2); key.position.set(2, 3, 5); scene.add(key);
      const cyan = new THREE.PointLight(0x00f0ff, 18, 0, 2); cyan.position.set(-3, 1, 2); scene.add(cyan);
      const magenta = new THREE.PointLight(0xff00ff, 18, 0, 2); magenta.position.set(3, 1.5, -2); scene.add(magenta);

      const bytes = Uint8Array.from(atob(GEOMETRY_GLB), (c) => c.charCodeAt(0));
      new GLTFLoader().parse(bytes.buffer, '', (gltf) => {
        const model = gltf.scene;
        // Centrar y escalar la placa para que llene el escenario
        const box = new THREE.Box3().setFromObject(model);
        const size = box.getSize(new THREE.Vector3());
        const center = box.getCenter(new THREE.Vector3());
        model.position.sub(center);
        const pivot = new THREE.Group();
        pivot.add(model);
        pivot.scale.setScalar(2.4 / Math.max(size.x, size.y, size.z));
        scene.add(pivot);

        new THREE.TextureLoader().load('/assets/studio/premio-textura.jpg', (texture) => {
          texture.flipY = false;
          texture.colorSpace = THREE.SRGBColorSpace;
          texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
          model.traverse((o) => {
            if (o.isMesh) {
              o.material = new THREE.MeshStandardMaterial({ map: texture, roughness: 0.38, metalness: 0.05, side: THREE.DoubleSide });
            }
          });
          stage.classList.add('is-3d');
        });

        camera.position.set(0, 0.2, 7.4);
        const controls = new OrbitControls(camera, canvas);
        canvas.style.touchAction = 'pan-y';
        controls.enableZoom = false;
        controls.enablePan = false;
        controls.enableDamping = true;
        controls.dampingFactor = 0.06;
        controls.rotateSpeed = 0.8;
        controls.minPolarAngle = Math.PI * 0.32;
        controls.maxPolarAngle = Math.PI * 0.62;
        controls.autoRotate = !reduce.matches;
        controls.autoRotateSpeed = 2.4;
        controls.target.set(0, 0, 0);

        // Al soltar, retoma el giro automático tras una pausa corta
        let resume = 0;
        controls.addEventListener('start', () => { controls.autoRotate = false; clearTimeout(resume); });
        controls.addEventListener('end', () => { resume = setTimeout(() => { controls.autoRotate = !reduce.matches; }, 1800); });

        const resize = () => {
          const { clientWidth: w, clientHeight: h } = stage;
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.position.z = w / h < 0.85 ? 8.8 : 7.4;
          camera.updateProjectionMatrix();
        };
        new ResizeObserver(resize).observe(stage);
        resize();

        const clock = new THREE.Clock();
        let visible = false, raf = 0;
        const loop = () => {
          const t = clock.getElapsedTime();
          if (!reduce.matches) pivot.position.y = Math.sin(t * 1.2) * 0.06;
          controls.update();
          renderer.render(scene, camera);
          raf = visible ? requestAnimationFrame(loop) : 0;
        };
        new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          if (visible && !raf) raf = requestAnimationFrame(loop);
        }).observe(stage);
      }, () => { /* si falla, se queda la foto de la placa */ });
    };

    if (stage && canvas) {
      try { start(); } catch (e) { /* sin WebGL: se queda la foto de la placa */ }
    }
  </script>
  <style is:global>

    :root {
      /* Paleta de Darkvoid (Base44): negro, cian #00F0FF y magenta #FF00FF.
         El blanco manda en la interfaz; cian y magenta son luz, no relleno. */
      --void: #050505;
      --hull: #0b0b0f;
      --rule: #262626;
      --starlight: #f5f5f7;
      --dust: #9ca3af;
      --cyan: #00f0ff;
      --magenta: #ff00ff;
      --violet: #7a1cff;
      --photon: var(--cyan);
      --ember: var(--magenta);
      --grad: linear-gradient(135deg, var(--cyan) 0%, var(--magenta) 100%);

      --font: "Archivo", system-ui, sans-serif;
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
      --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);

      --gutter: clamp(16px, 4vw, 48px);
      --max: 1280px;

      /* Escala tipográfica en cuarta perfecta (1.333) */
      --t-sm: 0.875rem;
      --t-base: 1rem;
      --t-md: 1.333rem;
      --t-lg: 1.777rem;
      --t-xl: clamp(2rem, 4vw, 2.369rem);
      --t-display: clamp(2rem, 4.9vw, 4.75rem);
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { color-scheme: dark; -webkit-text-size-adjust: 100%; scroll-padding-top: 88px; }
    @media (pointer: fine) { html { overscroll-behavior: none; } }
    a, button { touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
    @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
    body {
      margin: 0;
      background: var(--void);
      color: var(--starlight);
      font-family: var(--font);
      font-size: var(--t-base);
      font-variation-settings: "wdth" 100;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    img { display: block; max-width: 100%; }
    a { color: inherit; }
    h1, h2, h3, p, dl, dd, ul, ol, figure { margin: 0; }
