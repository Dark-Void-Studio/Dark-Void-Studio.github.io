---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Darkvoid Studios — Estudio indie en Lima, Perú | A.N.A. The Broken Link"
  description="Darkvoid Studios es un estudio indie de videojuegos en Lima, Perú. Creadores de A.N.A. — The Broken Link, 2.º mejor juego de Latinoamérica en GameJamPlus 25/26."
>

  <a class="skip-link" href="#contenido">Saltar al contenido</a>

  <header class="site-header">
    <nav class="wrap nav" aria-label="Principal">
      <a class="brand" href="#inicio" aria-label="Darkvoid Studios, inicio">
        <span class="brand-crop"><img decoding="async" src="/assets/studio/dark-void-logo.jpg" width="798" height="198" alt="Darkvoid Studios" loading="lazy"></span>
      </a>
      <ul class="nav-links">
        <li><a href="#juegos">Juegos</a></li>
        <li><a href="#premios">Premios</a></li>
        <li><a href="#tienda">Tienda</a></li>
        <li><a href="#equipo">Equipo</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
      <div class="nav-actions">
        <a class="btn btn-primary nav-cta" href="https://darkvvoidstudios.itch.io/ana">Jugar A.N.A.</a>
        <button class="cart-button" type="button" aria-haspopup="dialog" aria-controls="cart" aria-label="Abrir carrito, 0 productos">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span class="cart-count" aria-hidden="true">0</span>
        </button>
        <button class="btn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menú</button>
      </div>
    </nav>
  </header>

  <div class="mobile-menu" id="mobile-menu" data-open="false">
    <a href="#juegos">Juegos</a>
    <a href="#premios">Premios</a>
    <a href="#tienda">Tienda</a>
    <a href="#equipo">Equipo</a>
    <a href="#contacto">Contacto</a>
    <a class="btn btn-primary" href="https://darkvvoidstudios.itch.io/ana">Jugar A.N.A. en itch.io</a>
  </div>

  <main id="contenido">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="starfield" aria-hidden="true"></div>
      <div class="grid-floor" aria-hidden="true"></div>
      <div class="scanlines" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">Estudio indie de videojuegos en Lima, Perú</p>
          <h1 class="display" id="hero-title">
            <span class="line"><span>Mundos oscuros,</span></span>
            <span class="line"><span>historias</span></span>
            <span class="line"><span>inolvidables</span></span>
          </h1>
          <p class="lede">Contamos historias mediante videojuegos. Somos un equipo multicultural que crea experiencias en mundos oscuros, misteriosos y ricos en narrativa.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="https://darkvvoidstudios.itch.io/ana">Jugar A.N.A. en itch.io</a>
            <a class="btn btn-ghost" href="#juegos">Ver los juegos</a>
          </div>
          <dl class="highlights">
            <div><dt>Mejor juego de LATAM en GameJamPlus</dt><dd>2.º lugar</dd></div>
            <div><dt>Juegos lanzados</dt><dd>3</dd></div>
            <div><dt>Creadores en el equipo</dt><dd>13</dd></div>
          </dl>
        </div>

        <div class="void-stage" aria-hidden="true">
          <div class="void-parallax">
            <div class="void">
              <div class="glow"></div>
              <div class="disk back"><div class="disk-plane"><div class="disk-light"></div><div class="disk-streaks"></div></div></div>
              <div class="horizon"></div>
              <div class="lensing"></div>
              <div class="disk front"><div class="disk-plane"><div class="disk-light"></div><div class="disk-streaks"></div></div></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="juegos" aria-labelledby="juegos-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="h2" data-reveal id="juegos-title">Juegos</h2>
          <p>3 juegos lanzados, todos disponibles para jugar en itch.io.</p>
        </div>

        <article class="feature" data-reveal aria-labelledby="ana-title">
          <div class="feature-copy">
            <div class="game-meta">
              <span class="tag tag--date"><time datetime="2025-05">mayo de 2025</time></span>
              <span class="tag">Beat 'em up 2.5D</span>
              <span class="tag">Cyberpunk</span>
              <span class="tag">Synthwave</span>
              <span class="tag">Narrativo</span>
            </div>
            <h3 class="game-title" id="ana-title" translate="no">
              <span class="ana-logo" aria-hidden="true">
                <img decoding="async" class="ghost" src="/assets/studio/ana-logo.png" width="1162" height="468" alt="Logo de A.N.A. — The Broken Link" loading="lazy">
                <img decoding="async" class="ghost" src="/assets/studio/ana-logo.png" width="1162" height="468" alt="Logo de A.N.A. — The Broken Link" loading="lazy">
                <img decoding="async" class="main" src="/assets/studio/ana-logo.png" width="1162" height="468" alt="Logo de A.N.A. — The Broken Link" loading="lazy">
              </span>
              <span class="visually-hidden">A.N.A. — The Broken Link</span>
            </h3>
            <p class="feature-award"><span class="feature-award-mark" aria-hidden="true"></span>2.º mejor juego de Latinoamérica en GameJamPlus 25/26</p>
            <p class="game-desc">Beat 'em up narrativo inspirado en el anime, el cyberpunk y la estética synthwave. Sumérgete en una historia de mundos oscuros y personajes inolvidables.</p>
            <a class="btn btn-primary" href="https://darkvvoidstudios.itch.io/ana">Jugar A.N.A. en itch.io</a>
          </div>
          <div class="feature-device">
            <div class="device-glow" aria-hidden="true"></div>
            <div class="device-tilt">
              <div class="device-float">
                <img class="device" src="/assets/studio/ana-phone-1200.webp" width="1200" height="1033" loading="lazy" decoding="async"
                  alt="A.N.A. — The Broken Link jugándose en un teléfono: la protagonista pelea contra varios enemigos en una calle cyberpunk con luces magenta y cian">
                <span class="device-glare" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </article>

        <ul class="games">

          <li class="game game--small" data-reveal>
            <div class="cover reveal">
              <img src="/assets/studio/matchballance.webp" width="1280" height="720" loading="lazy" decoding="async"
                alt="Portada de Matchballance Season One: una esfera brillante junto al logo sobre un fondo morado">
            </div>
            <div class="game-meta">
              <span class="tag tag--date"><time datetime="2024-08">agosto de 2024</time></span>
              <span class="tag">Puzle</span>
              <span class="tag">Física</span>
              <span class="tag">Casual</span>
            </div>
            <h3 class="game-title" translate="no">Matchballance</h3>
            <p class="game-desc">Equilibra y combina esferas en plataformas que desafían la gravedad. Un puzle de física donde cada movimiento cuenta.</p>
            <a class="btn btn-ghost" href="https://peryloth.itch.io/matchballance">Jugar en itch.io<span class="visually-hidden">: Matchballance</span></a>
          </li>

          <li class="game game--small" data-reveal>
            <div class="cover reveal">
              <img src="/assets/studio/egg-dealer.webp" width="1280" height="720" loading="lazy" decoding="async"
                alt="Ilustración de Egg Dealer: Pichitolay huye con un huevo mientras varias aves lo persiguen">
            </div>
            <div class="game-meta">
              <span class="tag tag--date"><time datetime="2024-02">febrero de 2024</time></span>
              <span class="tag">Arcade</span>
              <span class="tag">Estrategia</span>
              <span class="tag">Casual</span>
            </div>
            <h3 class="game-title" translate="no">Egg Dealer</h3>
            <p class="game-desc">Ayuda a Pichitolay a escapar de las aves que quieren atraparlo por robar el huevo de su diosa Fenixa. Un arcade lleno de acción y estrategia.</p>
            <a class="btn btn-ghost" href="https://marthaescalante.itch.io/eggs-dealer">Jugar en itch.io<span class="visually-hidden">: Egg Dealer</span></a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="premios" aria-labelledby="premios-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="h2" data-reveal id="premios-title">Premios</h2>
          <p><span translate="no">A.N.A. — The Broken&nbsp;Link</span> en la edición 25/26 de GameJamPlus.</p>
        </div>
        <div class="trophies">
          <article class="trophy-card" data-reveal>
            <figure class="trophy-stage trophy-stage--badge">
              <div class="trophy-glow" aria-hidden="true"></div>
              <div class="trophy-ring" aria-hidden="true"></div>
              <div class="badge-float">
                <img class="badge" src="/assets/studio/premio-latam.webp" width="932" height="700" loading="lazy" decoding="async"
                  alt="Insignia de GameJamPlus 25/26, final global: Best Game LATAM, segundo lugar">
                <span class="badge-shine" aria-hidden="true"></span>
              </div>
            </figure>
            <p class="award-event">GameJamPlus 25/26, final global</p>
            <h3>2.º mejor juego de Latinoamérica</h3>
            <p class="award-desc"><span translate="no">A.N.A. — The Broken&nbsp;Link</span> fue reconocido como el segundo mejor juego de toda Latinoamérica en la final global de GameJamPlus.</p>
          </article>
          <article class="trophy-card" data-reveal>
            <figure class="trophy-stage trophy-stage--3d">
              <div class="trophy-glow" aria-hidden="true"></div>
              <div class="trophy-ring" aria-hidden="true"></div>
              <img class="trophy-poster" src="/assets/studio/premio-peru.webp" width="932" height="700" loading="lazy" decoding="async"
                alt="Placa de GameJamPlus 25/26: semifinal, juego destacado de LATAM">
              <canvas class="trophy-canvas" role="img" aria-label="Modelo 3D de la placa de GameJamPlus 25/26: semifinal, juego destacado de LATAM. Arrastra para girarla."></canvas>
              <figcaption class="model-hint">Placa en 3D: arrastra para girarla</figcaption>
            </figure>
            <p class="award-event">GameJamPlus 25/26, semifinal</p>
            <h3>Mejor juego de Perú y juego destacado de LATAM</h3>
            <p class="award-desc">En la semifinal de GameJamPlus fuimos elegidos el mejor juego de Perú y uno de los destacados de Latinoamérica.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="tienda" aria-labelledby="tienda-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="h2" data-reveal id="tienda-title">Tienda</h2>
          <p>Viste el void. Elige tu talla, añade al carrito y envía tu pedido. Envíos a todo Perú.</p>
        </div>
        <ul class="products">
          <li class="product spot" data-reveal data-id="camiseta-ana" data-name="Camiseta A.N.A. — The Broken Link" data-price="29.99" data-img="/assets/studio/tienda/camiseta-ana.webp">
            <div class="product-figure">
              <img src="/assets/studio/tienda/camiseta-ana.webp" width="800" height="800" loading="lazy" decoding="async"
                alt="Camiseta negra con la protagonista de A.N.A. en el frente y el logo del juego en la espalda">
            </div>
            <h3 class="product-name">Camiseta A.N.A. — The Broken&nbsp;Link</h3>
            <p class="product-desc">Camiseta oficial con diseño exclusivo del juego.</p>
            <p class="price"><span class="price-now" data-amount="29.99">$29.99</span></p>
            <div class="product-options">
              <fieldset class="sizes-field">
                <legend class="option-label">Talla</legend>
                <div class="sizes">
                  <label class="size"><input type="radio" name="talla-camiseta" value="S" checked><span>S</span></label>
                  <label class="size"><input type="radio" name="talla-camiseta" value="M"><span>M</span></label>
                  <label class="size"><input type="radio" name="talla-camiseta" value="L"><span>L</span></label>
                  <label class="size"><input type="radio" name="talla-camiseta" value="XL"><span>XL</span></label>
                </div>
              </fieldset>
            </div>
            <button class="btn btn-primary" type="button" data-add><span class="btn-label">Añadir al carrito</span></button>
          </li>

          <li class="product spot" data-reveal data-id="hoodie" data-name="Hoodie Darkvoid Studios" data-price="49.99" data-img="/assets/studio/tienda/hoodie.webp">
            <div class="product-figure">
              <span class="tag tag--date product-badge">Oferta</span>
              <img src="/assets/studio/tienda/hoodie.webp" width="800" height="800" loading="lazy" decoding="async"
                alt="Hoodie negro con el logo de Dark Void dentro de un anillo de luz cian y morada, vista frontal y trasera">
            </div>
            <h3 class="product-name">Hoodie Darkvoid Studios</h3>
            <p class="product-desc">Hoodie oficial con el logo del estudio.</p>
            <p class="price"><span class="price-now" data-amount="49.99">$49.99</span><span class="price-was" data-amount="69.99"><span class="visually-hidden">Antes: </span>$69.99</span></p>
            <div class="product-options">
              <fieldset class="sizes-field">
                <legend class="option-label">Talla</legend>
                <div class="sizes">
                  <label class="size"><input type="radio" name="talla-hoodie" value="S" checked><span>S</span></label>
                  <label class="size"><input type="radio" name="talla-hoodie" value="M"><span>M</span></label>
                  <label class="size"><input type="radio" name="talla-hoodie" value="L"><span>L</span></label>
                  <label class="size"><input type="radio" name="talla-hoodie" value="XL"><span>XL</span></label>
                </div>
              </fieldset>
            </div>
            <button class="btn btn-primary" type="button" data-add><span class="btn-label">Añadir al carrito</span></button>
          </li>

          <li class="product spot" data-reveal data-id="taza-ana" data-name="Taza A.N.A. — The Broken Link" data-price="14.99" data-img="/assets/studio/tienda/taza-ana.webp">
            <div class="product-figure">
              <img src="/assets/studio/tienda/taza-ana.webp" width="800" height="800" loading="lazy" decoding="async"
                alt="Taza negra con la protagonista de A.N.A. sobre una ciudad nocturna cyberpunk">
            </div>
            <h3 class="product-name">Taza A.N.A. — The Broken&nbsp;Link</h3>
            <p class="product-desc">Taza oficial para tus sesiones de juego.</p>
            <p class="price"><span class="price-now" data-amount="14.99">$14.99</span></p>
            <div class="product-options"><p class="option-note">Talla única</p></div>
            <button class="btn btn-primary" type="button" data-add><span class="btn-label">Añadir al carrito</span></button>
          </li>

          <li class="product product--soldout spot" data-reveal>
            <div class="product-figure">
              <span class="tag product-badge tag--soldout">Agotado</span>
              <img src="/assets/studio/tienda/hoodie-limitada.webp" width="800" height="800" loading="lazy" decoding="async"
                alt="Hoodie negro de edición limitada con el logo de Dark Void y detalles morados, vista frontal y trasera">
            </div>
            <h3 class="product-name">Darkvoid Hoodie — Edición Limitada</h3>
            <p class="product-desc">Hoodie exclusivo con estética cyberpunk.</p>
            <p class="price"><span class="price-now" data-amount="45">$45.00</span></p>
            <div class="product-options"><p class="option-note">Sin stock por ahora</p></div>
            <button class="btn btn-ghost" type="button" disabled>Agotado</button>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" id="equipo" aria-labelledby="equipo-title">
      <div class="wrap">
        <div class="section-head">
          <h2 class="h2" data-reveal id="equipo-title">Equipo</h2>
          <p>13 creadores impulsados por la creatividad y la pasión, desde Lima hacia el mundo.</p>
        </div>
        <ul class="team">
          <li class="member member--lead" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/martha.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Martha Escalante"></div><div><p class="member-name">Martha Escalante</p><p class="member-handle" translate="no">@QueenWarrior</p><p class="member-role">Dirección general, UX, narrativa, game design y producción</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/camila.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Camila Silva"></div><div><p class="member-name">Camila Silva</p><p class="member-role">Dirección narrativa, arte de UI y community manager</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/enier.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Enier"></div><div><p class="member-name">Enier</p><p class="member-role">Dirección artística, animación, level design, diseño de personajes, ensamble y VFX</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/alvaro.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Álvaro Racchumi"></div><div><p class="member-name">Álvaro Racchumi</p><p class="member-handle" translate="no">@SuperGamer15</p><p class="member-role">Dirección de software y programación de UI</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/peryloth.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de PeryLoth"></div><div><p class="member-name" translate="no">PeryLoth</p><p class="member-role">Programación de mecánicas, personajes y enemigos</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/ralph.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Ralph Dudley Maura Ayquipa"></div><div><p class="member-name">Ralph Dudley Maura Ayquipa</p><p class="member-handle" translate="no">@SharpWalker14</p><p class="member-role">Programación de UX</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/giorgio.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Giorgio"></div><div><p class="member-name">Giorgio</p><p class="member-handle" translate="no">@Ilustra2023</p><p class="member-role">Arte 2D, creación de contenido y marketing</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/daneth.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Daneth"></div><div><p class="member-name">Daneth</p><p class="member-role">Arte de personajes y fondos</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/elaias.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Elaias"></div><div><p class="member-name">Elaias</p><p class="member-role">Arte 3D</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/daigoro.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Dáigoro Ventura"></div><div><p class="member-name">Dáigoro Ventura</p><p class="member-role">Diseño de SFX y composición musical</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/cristian.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Cristian Lavado"></div><div><p class="member-name">Cristian Lavado</p><p class="member-role">Composición musical</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/luisa.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Luisa Zarama"></div><div><p class="member-name">Luisa Zarama</p><p class="member-role">Diseño de audio</p></div></li>
          <li class="member" data-reveal><div class="member-frame"><img class="member-photo" src="/assets/studio/equipo/luis.webp" width="640" height="800" loading="lazy" decoding="async" alt="Foto de Luis Fernandez"></div><div><p class="member-name">Luis Fernandez</p><p class="member-handle" translate="no">@Chuma</p><p class="member-role">Lead QA</p></div></li>
        </ul>
      </div>
    </section>

    <section class="section" id="contacto" aria-labelledby="contacto-title">
      <div class="wrap contact">
        <div>
          <h2 class="contact-title" id="contacto-title">Hablemos de tu proyecto</h2>
          <p class="contact-intro">Escríbenos para colaboraciones, prensa, pedidos de la tienda o cualquier pregunta sobre nuestros juegos.</p>
          <dl class="contact-list" style="margin-top:32px">
            <div><dt>Correo</dt><dd><a href="mailto:darkvoidstu@gmail.com">darkvoidstu@gmail.com</a></dd></div>
            <div><dt>Ubicación</dt><dd>Lima, Perú</dd></div>
            <div><dt>Juegos</dt><dd><a href="https://darkvvoidstudios.itch.io/" translate="no">darkvvoidstudios.itch.io</a></dd></div>
          </dl>
        </div>
        <form class="contact-form" id="contact-form" novalidate>
          <div class="field-row-2">
            <div class="field">
              <label for="cf-name">Nombre</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="cf-name-error">
              <p class="field-error" id="cf-name-error"></p>
            </div>
            <div class="field">
              <label for="cf-email">Correo electrónico</label>
              <input id="cf-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" placeholder="tu@correo.com…" required aria-describedby="cf-email-error">
              <p class="field-error" id="cf-email-error"></p>
            </div>
          </div>
          <div class="field">
            <label for="cf-subject">Asunto <span class="optional">(opcional)</span></label>
            <input id="cf-subject" name="subject" type="text" autocomplete="off">
          </div>
          <div class="field">
            <label for="cf-message">Mensaje</label>
            <textarea id="cf-message" name="message" required aria-describedby="cf-message-error"></textarea>
            <p class="field-error" id="cf-message-error"></p>
          </div>
          <div class="honey" aria-hidden="true"><label for="cf-honey">No llenar</label><input id="cf-honey" name="_honey" type="text" tabindex="-1" autocomplete="off"></div>
          <div><button class="btn btn-primary" type="submit"><span class="btn-label">Enviar mensaje</span></button></div>
          <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <div class="cart-overlay" data-open="false" aria-hidden="true"></div>
  <aside class="cart" id="cart" role="dialog" aria-modal="true" aria-labelledby="cart-title" data-open="false" data-step="items" inert>
    <header class="cart-head">
      <h2 class="cart-title" id="cart-title">Tu carrito</h2>
      <button class="cart-close" type="button" aria-label="Cerrar carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </header>

    <div class="cart-body">
      <ul class="cart-items" aria-label="Productos en el carrito"></ul>
      <div class="cart-empty">
        <p>Tu carrito está vacío.</p>
        <a class="btn btn-ghost" href="#tienda" data-close-cart>Ver la tienda</a>
      </div>

      <form class="checkout" id="checkout" novalidate>
        <h3 class="checkout-title">Datos de envío</h3>
        <div class="field">
          <label for="co-name">Nombre completo</label>
          <input id="co-name" name="nombre" type="text" autocomplete="name" required aria-describedby="co-name-error">
          <p class="field-error" id="co-name-error"></p>
        </div>
        <div class="field">
          <label for="co-email">Correo electrónico</label>
          <input id="co-email" name="email" type="email" inputmode="email" autocomplete="email" spellcheck="false" placeholder="tu@correo.com…" required aria-describedby="co-email-error">
          <p class="field-error" id="co-email-error"></p>
        </div>
        <div class="field">
          <label for="co-phone">Teléfono o WhatsApp</label>
          <input id="co-phone" name="telefono" type="tel" inputmode="tel" autocomplete="tel" placeholder="+51 999 999 999…" required aria-describedby="co-phone-error">
          <p class="field-error" id="co-phone-error"></p>
        </div>
        <div class="field">
          <label for="co-address">Dirección de envío</label>
          <input id="co-address" name="direccion" type="text" autocomplete="street-address" required aria-describedby="co-address-error">
          <p class="field-error" id="co-address-error"></p>
        </div>
        <div class="field">
          <label for="co-city">Distrito y ciudad</label>
          <input id="co-city" name="ciudad" type="text" autocomplete="address-level2" placeholder="Miraflores, Lima…" required aria-describedby="co-city-error">
          <p class="field-error" id="co-city-error"></p>
        </div>
        <div class="field">
          <label for="co-notes">Notas <span class="optional">(opcional)</span></label>
          <textarea id="co-notes" name="notas" rows="3" autocomplete="off"></textarea>
        </div>
      </form>

      <div class="cart-done" tabindex="-1">
        <h3 class="checkout-title">Pedido enviado</h3>
        <p class="cart-done-text"></p>
        <button class="btn btn-ghost" type="button" data-close-cart>Seguir mirando</button>
      </div>
    </div>

    <footer class="cart-foot">
      <div class="cart-total"><span>Total</span><strong class="cart-subtotal">USD 0.00</strong></div>
      <p class="cart-note">El envío y el pago se coordinan por correo o WhatsApp después de recibir tu pedido.</p>
      <p class="form-status cart-status" role="status" aria-live="polite"></p>
      <div class="cart-actions">
        <button class="btn btn-ghost cart-back" type="button">Volver</button>
        <button class="btn btn-primary cart-next" type="button"><span class="btn-label">Continuar con el pedido</span></button>
      </div>
    </footer>
  </aside>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <a class="brand" href="#inicio" aria-label="Darkvoid Studios, volver al inicio">
          <span class="brand-crop"><img decoding="async" src="/assets/studio/dark-void-logo.jpg" width="798" height="198" alt="Darkvoid Studios" loading="lazy"></span>
        </a>
        <nav aria-label="Pie de página">
          <ul class="footer-links">
            <li><a href="#juegos">Juegos</a></li>
            <li><a href="#premios">Premios</a></li>
            <li><a href="#tienda">Tienda</a></li>
            <li><a href="#equipo">Equipo</a></li>
            <li><a href="#contacto">Contacto</a></li>
            <li><a href="https://darkvvoidstudios.itch.io/">itch.io</a></li>
          </ul>
        </nav>
      </div>
      <p class="footer-legal">© 2026 <span translate="no">Darkvoid Studios</span>. Lima, Perú.</p>
    </div>
  </footer>

  
  
  

<script is:inline>
    document.documentElement.classList.add('js');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Menú móvil
    const toggle = document.querySelector('.menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const setMenu = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Cerrar' : 'Menú';
      menu.dataset.open = String(open);
    };
    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => { if (e.target.closest('a')) setMenu(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setMenu(false); toggle.focus(); }
    });

    // Parallax con resorte sobre el agujero negro (decorativo, solo con puntero fino)
    const hero = document.querySelector('.hero');
    const layer = document.querySelector('.void-parallax');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, heroRect = null;
    const step = () => {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      layer.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
      raf = (Math.abs(tx - cx) > 0.05 || Math.abs(ty - cy) > 0.05) ? requestAnimationFrame(step) : 0;
    };
    hero.addEventListener('pointermove', (e) => {
      if (reduceMotion.matches || !finePointer.matches) return;
      const r = heroRect || (heroRect = hero.getBoundingClientRect());
      tx = ((e.clientX - r.left) / r.width - 0.5) * -24;
      ty = ((e.clientY - r.top) / r.height - 0.5) * -24;
      if (!raf) raf = requestAnimationFrame(step);
    });
    hero.addEventListener('pointerleave', () => { heroRect = null; tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(step); });
    window.addEventListener('scroll', () => { heroRect = null; }, { passive: true });
    window.addEventListener('resize', () => { heroRect = null; });

    // Fechas de lanzamiento con el formato del idioma de la página
    const monthFormat = new Intl.DateTimeFormat(document.documentElement.lang, { month: 'long', year: 'numeric', timeZone: 'UTC' });
    document.querySelectorAll('time[datetime]').forEach((el) => {
      const value = el.getAttribute('datetime');
      if (/^\d{4}-\d{2}$/.test(value)) el.textContent = monthFormat.format(new Date(`${value}-01T00:00:00Z`));
    });

    // Pausar el giro del disco fuera de pantalla; revelar portadas una sola vez
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => hero.classList.toggle('is-offscreen', !entry.isIntersecting)).observe(hero);
      const reveal = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) { entry.target.classList.add('is-in'); reveal.unobserve(entry.target); }
        });
      }, { rootMargin: '0px 0px -12% 0px' });
      document.querySelectorAll('.cover.reveal').forEach((el) => reveal.observe(el));
    } else {
      document.querySelectorAll('.cover.reveal').forEach((el) => el.classList.add('is-in'));
    }

    // Revelado al hacer scroll, escalonado entre hermanos
    const revealTargets = document.querySelectorAll('[data-reveal]');
    revealTargets.forEach((el) => {
      const siblings = [...el.parentElement.children].filter((c) => c.hasAttribute('data-reveal'));
      el.style.setProperty('--i', Math.min(siblings.indexOf(el), 8));
    });
    const anaLogo = document.querySelector('.ana-logo');
    const glitch = () => {
      if (reduceMotion.matches || !anaLogo) return;
      anaLogo.classList.remove('is-glitching');
      void anaLogo.offsetWidth;
      anaLogo.classList.add('is-glitching');
    };
    if ('IntersectionObserver' in window) {
      const revealer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          if (entry.target.contains(anaLogo)) setTimeout(glitch, 500);
          revealer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -10% 0px' });
      revealTargets.forEach((el) => revealer.observe(el));
    } else {
      revealTargets.forEach((el) => el.classList.add('is-in'));
    }
    anaLogo?.closest('.feature')?.addEventListener('pointerenter', glitch);

    // Foco de luz que sigue al puntero (se escribe en la propia tarjeta, no en el contenedor)
    document.querySelectorAll('.spot').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        if (!finePointer.matches) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });


    // Teléfono de A.N.A.: se inclina hacia el puntero con un resorte (decorativo)
    const feature = document.querySelector('.feature');
    const tilt = document.querySelector('.device-tilt');
    if (feature && tilt) {
      let rx = 0, ry = 0, crx = 0, cry = 0, tiltRaf = 0, fRect = null;
      const tiltStep = () => {
        crx += (rx - crx) * 0.08; cry += (ry - cry) * 0.08;
        tilt.style.transform = `perspective(900px) rotateX(${crx.toFixed(2)}deg) rotateY(${cry.toFixed(2)}deg)`;
        tiltRaf = (Math.abs(rx - crx) > 0.02 || Math.abs(ry - cry) > 0.02) ? requestAnimationFrame(tiltStep) : 0;
      };
      feature.addEventListener('pointermove', (e) => {
        if (reduceMotion.matches || !finePointer.matches) return;
        const r = fRect || (fRect = feature.getBoundingClientRect());
        ry = ((e.clientX - r.left) / r.width - 0.5) * 14;
        rx = ((e.clientY - r.top) / r.height - 0.5) * -10;
        if (!tiltRaf) tiltRaf = requestAnimationFrame(tiltStep);
      });
      feature.addEventListener('pointerleave', () => { fRect = null; rx = 0; ry = 0; if (!tiltRaf) tiltRaf = requestAnimationFrame(tiltStep); });
      window.addEventListener('scroll', () => { fRect = null; }, { passive: true });
    }

    // Precios en dólares con el formato del idioma de la página
    const money = new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'USD' });
    document.querySelectorAll('[data-amount]').forEach((el) => {
      const hidden = el.querySelector('.visually-hidden');
      el.textContent = money.format(Number(el.dataset.amount));
      if (hidden) el.prepend(hidden);
    });

    // Formulario de contacto: FormSubmit envía cada mensaje a darkvoidstu@gmail.com con copia a Martha
    const STUDIO_EMAIL = 'darkvoidstu@gmail.com';
    const CC_EMAIL = 'marthasharaitescalante21@gmail.com';
    const contactForm = document.getElementById('contact-form');
    const cf = {
      name: document.getElementById('cf-name'),
      email: document.getElementById('cf-email'),
      subject: document.getElementById('cf-subject'),
      message: document.getElementById('cf-message'),
      honey: document.getElementById('cf-honey'),
      status: document.getElementById('cf-status'),
      button: contactForm.querySelector('button[type="submit"]'),
    };
    const cfLabel = cf.button.querySelector('.btn-label');
    const setFieldError = (input, text) => {
      const out = document.getElementById(input.id + '-error');
      if (text) { input.setAttribute('aria-invalid', 'true'); out.textContent = text; }
      else { input.removeAttribute('aria-invalid'); out.textContent = ''; }
    };
    const validate = () => {
      const errors = [];
      const name = cf.name.value.trim();
      const email = cf.email.value.trim();
      const message = cf.message.value.trim();
      setFieldError(cf.name, name ? '' : 'Escribe tu nombre.');
      if (!name) errors.push(cf.name);
      const emailMsg = !email ? 'Escribe tu correo para que podamos responderte.'
        : !cf.email.checkValidity() ? 'Ese correo no es válido. Revisa que tenga @ y un dominio, por ejemplo tu@correo.com.' : '';
      setFieldError(cf.email, emailMsg);
      if (emailMsg) errors.push(cf.email);
      setFieldError(cf.message, message ? '' : 'Escribe tu mensaje.');
      if (!message) errors.push(cf.message);
      return errors;
    };
    [cf.name, cf.email, cf.message].forEach((input) => input.addEventListener('input', () => {
      if (input.getAttribute('aria-invalid') === 'true') validate();
    }));
    const mailtoFallback = () => {
      const params = new URLSearchParams({
        cc: CC_EMAIL,
        subject: cf.subject.value.trim() || 'Mensaje desde la web de Darkvoid Studios',
        body: `${cf.message.value.trim()}\n\n${cf.name.value.trim()} (${cf.email.value.trim()})`,
      });
      return `mailto:${STUDIO_EMAIL}?${params.toString().replace(/\+/g, '%20')}`;
    };
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (cf.button.dataset.busy === 'true') return;
      const errors = validate();
      if (errors.length) {
        cf.status.dataset.state = 'error';
        cf.status.textContent = 'Revisa los campos marcados.';
        errors[0].focus();
        return;
      }
      if (cf.honey.value) return;
      cf.button.dataset.busy = 'true';
      cfLabel.textContent = 'Enviando…';
      cf.status.dataset.state = '';
      cf.status.textContent = '';
      try {
        const res = await fetch(`https://formsubmit.co/ajax/${STUDIO_EMAIL}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: cf.name.value.trim(),
            email: cf.email.value.trim(),
            _subject: cf.subject.value.trim() || 'Mensaje desde la web de Darkvoid Studios',
            message: cf.message.value.trim(),
            _cc: CC_EMAIL,
            _template: 'table',
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || String(data.success) !== 'true') throw new Error(data.message || 'send_failed');
        cf.status.dataset.state = 'success';
        cf.status.textContent = `Mensaje enviado. Te responderemos a ${cf.email.value.trim()}.`;
        contactForm.reset();
        cfLabel.textContent = 'Enviar mensaje';
      } catch (err) {
        cf.status.dataset.state = 'error';
        if (/activat/i.test(err.message)) {
          // Solo ocurre la primera vez: FormSubmit pide confirmar el correo del estudio
          cf.status.textContent = `El formulario necesita activarse: revisa la bandeja de ${STUDIO_EMAIL} y abre el enlace "Activate Form" de FormSubmit. Después, vuelve a enviar este mensaje.`;
          cfLabel.textContent = 'Enviar mensaje';
          return;
        }
        cf.status.textContent = 'No se pudo enviar el mensaje desde aquí. ';
        const link = document.createElement('a');
        link.href = mailtoFallback();
        link.textContent = 'Envíalo desde tu correo';
        cf.status.append(link, ' con el texto que ya escribiste.');
        cfLabel.textContent = 'Enviar mensaje';
      } finally {
        cf.button.dataset.busy = 'false';
      }
    });

    // Carrito: se guarda en este navegador y el pedido se envía por FormSubmit a los dos correos
    const CART_KEY = 'darkvoid-cart';
    const cartEl = document.getElementById('cart');
    const cartOverlay = document.querySelector('.cart-overlay');
    const cartButton = document.querySelector('.cart-button');
    const cartCount = cartButton.querySelector('.cart-count');
    const cartList = cartEl.querySelector('.cart-items');
    const cartSubtotal = cartEl.querySelector('.cart-subtotal');
    const cartNext = cartEl.querySelector('.cart-next');
    const cartNextLabel = cartNext.querySelector('.btn-label');
    const cartBack = cartEl.querySelector('.cart-back');
    const cartStatus = cartEl.querySelector('.cart-status');
    const checkout = document.getElementById('checkout');
    const pageParts = [document.querySelector('.site-header'), document.getElementById('contenido'), document.querySelector('.site-footer')];
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem(CART_KEY) || '[]'); } catch (e) { cart = []; }
    if (!Array.isArray(cart)) cart = [];
    const saveCart = () => { try { localStorage.setItem(CART_KEY, JSON.stringify(cart)); } catch (e) { /* sin almacenamiento: el carrito vive solo en esta visita */ } };
    const cartQty = () => cart.reduce((n, item) => n + item.qty, 0);
    const cartTotal = () => cart.reduce((n, item) => n + item.qty * item.price, 0);
    const itemLabel = (item) => `${item.name}${item.size ? ` talla ${item.size}` : ''}`;

    // Tras cambiar cantidades, el foco se queda en un control equivalente en lugar de perderse
    const focusAfterChange = (index, which) => {
      const rows = cartList.querySelectorAll('.cart-item');
      const row = rows[Math.min(index, rows.length - 1)];
      if (!row) { cartEl.querySelector('.cart-empty a')?.focus(); return; }
      row.querySelector(which === '+' ? '.stepper button:last-child' : '.stepper button:first-child').focus();
    };

    const renderCart = () => {
      const count = cartQty();
      cartButton.dataset.count = String(count);
      cartCount.textContent = String(count);
      cartButton.setAttribute('aria-label', `Abrir carrito, ${count} ${count === 1 ? 'producto' : 'productos'}`);
      cartEl.dataset.empty = String(cart.length === 0);
      cartSubtotal.textContent = money.format(cartTotal());
      cartList.replaceChildren(...cart.map((item, index) => {
        const li = document.createElement('li');
        li.className = 'cart-item';
        const img = document.createElement('img');
        img.src = item.img; img.alt = ''; img.width = 72; img.height = 72;
        const info = document.createElement('div');
        const name = document.createElement('p'); name.className = 'cart-item-name'; name.textContent = item.name;
        const meta = document.createElement('p'); meta.className = 'cart-item-meta';
        meta.textContent = `${item.size ? `Talla ${item.size}, ` : ''}${money.format(item.price)} c/u`;
        const stepper = document.createElement('div'); stepper.className = 'stepper';
        const minus = document.createElement('button'); minus.type = 'button'; minus.textContent = '−';
        minus.setAttribute('aria-label', `Quitar una unidad de ${itemLabel(item)}`);
        const out = document.createElement('output'); out.textContent = String(item.qty);
        out.setAttribute('aria-label', `Cantidad: ${item.qty}`);
        const plus = document.createElement('button'); plus.type = 'button'; plus.textContent = '+';
        plus.setAttribute('aria-label', `Añadir una unidad de ${itemLabel(item)}`);
        minus.addEventListener('click', () => { item.qty -= 1; if (item.qty < 1) cart.splice(index, 1); saveCart(); renderCart(); focusAfterChange(index); });
        plus.addEventListener('click', () => { item.qty = Math.min(item.qty + 1, 20); saveCart(); renderCart(); focusAfterChange(index, '+'); });
        stepper.append(minus, out, plus);
        info.append(name, meta, stepper);
        const side = document.createElement('div');
        const price = document.createElement('p'); price.className = 'cart-item-price'; price.textContent = money.format(item.qty * item.price);
        const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'cart-remove'; remove.textContent = 'Quitar';
        remove.setAttribute('aria-label', `Quitar ${itemLabel(item)} del carrito`);
        remove.addEventListener('click', () => { cart.splice(index, 1); saveCart(); renderCart(); focusAfterChange(index); });
        side.append(price, remove);
        li.append(img, info, side);
        return li;
      }));
    };

    let lastFocus = null;
    const setStep = (step) => {
      cartEl.dataset.step = step;
      cartStatus.textContent = ''; cartStatus.dataset.state = '';
      cartNextLabel.textContent = step === 'checkout' ? 'Enviar pedido' : 'Continuar con el pedido';
    };
    const openCart = () => {
      lastFocus = document.activeElement;
      if (cartEl.dataset.step === 'done') setStep('items');
      cartEl.inert = false;
      cartEl.dataset.open = 'true';
      cartOverlay.dataset.open = 'true';
      pageParts.forEach((el) => { if (el) el.inert = true; });
      document.documentElement.style.overflow = 'hidden';
      cartEl.querySelector('.cart-close').focus();
    };
    const closeCart = () => {
      cartEl.dataset.open = 'false';
      cartOverlay.dataset.open = 'false';
      pageParts.forEach((el) => { if (el) el.inert = false; });
      document.documentElement.style.overflow = '';
      cartEl.inert = true;
      const back = lastFocus && lastFocus !== document.body && document.contains(lastFocus) && !cartEl.contains(lastFocus) ? lastFocus : cartButton;
      back.focus();
    };
    cartButton.addEventListener('click', openCart);
    cartEl.querySelector('.cart-close').addEventListener('click', closeCart);
    cartOverlay.addEventListener('click', closeCart);
    cartEl.addEventListener('click', (e) => { if (e.target.closest('[data-close-cart]')) closeCart(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && cartEl.dataset.open === 'true') closeCart(); });

    document.querySelectorAll('[data-add]').forEach((button) => {
      const label = button.querySelector('.btn-label');
      let timer = 0;
      button.addEventListener('click', () => {
        const card = button.closest('.product');
        const size = card.querySelector('input[type="radio"]:checked')?.value || '';
        const id = card.dataset.id;
        const existing = cart.find((item) => item.id === id && item.size === size);
        if (existing) existing.qty = Math.min(existing.qty + 1, 20);
        else cart.push({ id, name: card.dataset.name, size, price: Number(card.dataset.price), img: card.dataset.img, qty: 1 });
        saveCart(); renderCart();
        if (cartEl.dataset.step === 'done') setStep('items');
        label.textContent = size ? `Añadido, talla ${size}` : 'Añadido al carrito';
        button.classList.remove('is-added'); void button.offsetWidth; button.classList.add('is-added');
        cartCount.classList.remove('is-bump'); void cartCount.offsetWidth; cartCount.classList.add('is-bump');
        clearTimeout(timer);
        timer = setTimeout(() => { label.textContent = 'Añadir al carrito'; button.classList.remove('is-added'); }, 1600);
      });
    });

    const coFields = ['co-name', 'co-email', 'co-phone', 'co-address', 'co-city'].map((id) => document.getElementById(id));
    const coMessages = {
      'co-name': 'Escribe tu nombre completo.',
      'co-phone': 'Escribe un teléfono o WhatsApp para coordinar el envío.',
      'co-address': 'Escribe la dirección donde quieres recibir el pedido.',
      'co-city': 'Escribe tu distrito y ciudad.',
    };
    const validateCheckout = () => {
      const errors = [];
      coFields.forEach((input) => {
        const value = input.value.trim();
        let msg = '';
        if (input.id === 'co-email') {
          msg = !value ? 'Escribe tu correo para enviarte la confirmación.'
            : !input.checkValidity() ? 'Ese correo no es válido. Revisa que tenga @ y un dominio, por ejemplo tu@correo.com.' : '';
        } else if (!value) {
          msg = coMessages[input.id];
        }
        setFieldError(input, msg);
        if (msg) errors.push(input);
      });
      return errors;
    };
    coFields.forEach((input) => input.addEventListener('input', () => { if (input.getAttribute('aria-invalid') === 'true') validateCheckout(); }));

    cartBack.addEventListener('click', () => setStep('items'));
    cartNext.addEventListener('click', async () => {
      if (cartEl.dataset.step === 'items') {
        setStep('checkout');
        document.getElementById('co-name').focus();
        return;
      }
      if (cartNext.dataset.busy === 'true') return;
      const errors = validateCheckout();
      if (errors.length) {
        cartStatus.dataset.state = 'error';
        cartStatus.textContent = 'Revisa los campos marcados.';
        errors[0].focus();
        return;
      }
      const v = (id) => document.getElementById(id).value.trim();
      const lines = cart.map((item) => `${item.qty} x ${item.name}${item.size ? ` (talla ${item.size})` : ''}: ${money.format(item.qty * item.price)}`);
      const order = [
        'Nuevo pedido desde la tienda web',
        '',
        ...lines,
        '',
        `Total: ${money.format(cartTotal())} (sin envío)`,
        '',
        `Nombre: ${v('co-name')}`,
        `Correo: ${v('co-email')}`,
        `Teléfono: ${v('co-phone')}`,
        `Dirección: ${v('co-address')}`,
        `Distrito y ciudad: ${v('co-city')}`,
        v('co-notes') ? `Notas: ${v('co-notes')}` : null,
      ].filter((line) => line !== null).join('\n');
      cartNext.dataset.busy = 'true';
      cartNextLabel.textContent = 'Enviando pedido…';
      cartStatus.textContent = ''; cartStatus.dataset.state = '';
      try {
        const res = await fetch(`https://formsubmit.co/ajax/${STUDIO_EMAIL}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: v('co-name'),
            email: v('co-email'),
            telefono: v('co-phone'),
            direccion: `${v('co-address')}, ${v('co-city')}`,
            pedido: lines.join('\n'),
            total: money.format(cartTotal()),
            notas: v('co-notes'),
            _subject: `Nuevo pedido web: ${v('co-name')} (${money.format(cartTotal())})`,
            _cc: CC_EMAIL,
            _template: 'table',
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || String(data.success) !== 'true') throw new Error(data.message || 'send_failed');
        cartEl.querySelector('.cart-done-text').textContent = `Gracias, ${v('co-name').split(' ')[0]}. Te escribiremos a ${v('co-email')} o al ${v('co-phone')} para coordinar el pago y el envío.`;
        cart = []; saveCart(); renderCart(); checkout.reset();
        setStep('done');
        cartEl.querySelector('.cart-done').focus();
      } catch (err) {
        cartStatus.dataset.state = 'error';
        if (/activat/i.test(err.message)) {
          cartStatus.textContent = `La tienda aún no puede recibir pedidos: falta activar el formulario en ${STUDIO_EMAIL}.`;
        } else {
          const params = new URLSearchParams({ cc: CC_EMAIL, subject: `Nuevo pedido web: ${v('co-name')}`, body: order });
          cartStatus.textContent = 'No se pudo enviar el pedido desde aquí. ';
          const link = document.createElement('a');
          link.href = `mailto:${STUDIO_EMAIL}?${params.toString().replace(/\+/g, '%20')}`;
          link.textContent = 'Envíalo desde tu correo';
          cartStatus.append(link, ' con el pedido ya escrito.');
        }
      } finally {
        cartNext.dataset.busy = 'false';
        if (cartEl.dataset.step === 'checkout') cartNextLabel.textContent = 'Enviar pedido';
      }
    });
    renderCart();
  </script>
