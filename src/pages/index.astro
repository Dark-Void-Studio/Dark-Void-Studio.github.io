    .hero h1 { margin-bottom: 28px; }
    .hero h1 .line { display: block; overflow: hidden; padding-bottom: 0.04em; }
    .hero h1 .line > span { display: block; }
    .hero .lede { margin-bottom: 36px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 40px; }
    .highlights { display: flex; flex-wrap: wrap; gap: 12px 32px; }
    .highlights div { display: flex; flex-direction: column-reverse; }
    .highlights dt { color: var(--dust); font-size: var(--t-sm); }
    .highlights dd {
      font-size: var(--t-lg); font-weight: 850; font-variation-settings: "wdth" 120; font-variant-numeric: tabular-nums; line-height: 1.15;
      background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent;
    }

    /* Suelo synthwave y scanlines: el horizonte del void */
    .grid-floor {
      position: absolute; left: -25%; right: -25%; bottom: 0; height: 46%; z-index: -1; pointer-events: none;
      perspective: 420px; perspective-origin: 50% 0%; overflow: hidden;
      -webkit-mask: linear-gradient(to bottom, transparent 0%, #000 40%, #000 100%);
      mask: linear-gradient(to bottom, transparent 0%, #000 40%, #000 100%);
    }
    .grid-floor::before {
      content: ""; position: absolute; left: 0; right: 0; top: 0; height: 200%;
      transform-origin: 50% 0%;
      background-image:
        linear-gradient(to right, rgba(0, 240, 255, .28) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 0, 255, .26) 1px, transparent 1px);
      background-size: 64px 64px;
      transform: rotateX(68deg) translateY(0);
      animation: floor 3.2s linear infinite;
    }
    .scanlines {
      position: absolute; inset: 0; z-index: 5; pointer-events: none; opacity: .035;
      background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(0, 240, 255, .9) 3px 4px);
      mix-blend-mode: screen;
    }
    @keyframes floor { to { transform: rotateX(68deg) translateY(64px); } }
    .hero.is-offscreen .grid-floor::before, .hero.is-paused .grid-floor::before { animation-play-state: paused; }

    /* El agujero negro: eco de la "O" del logo */
    .void-stage { position: relative; aspect-ratio: 1; width: 100%; max-width: 720px; justify-self: center; }
    .void-parallax { position: absolute; inset: 0; will-change: transform; }
    .void { position: absolute; inset: 0; --tilt: -14deg; }
    .glow {
      position: absolute; inset: 8%; border-radius: 50%;
      background: radial-gradient(circle, rgba(0,240,255,.16) 0%, rgba(255,0,255,.10) 35%, transparent 62%);
      filter: blur(12px);
    }
    .disk {
      position: absolute; left: -12%; right: -12%; top: 50%;
      aspect-ratio: 1; transform: translateY(-50%) rotate(var(--tilt));
    }
    .disk-plane { position: absolute; inset: 0; transform: scaleY(0.24); }
    .disk.front .disk-plane { clip-path: inset(50% 0 0 0); }
    .disk-light, .disk-streaks {
      position: absolute; inset: 0; border-radius: 50%;
      -webkit-mask: radial-gradient(circle, transparent 0 27%, #000 31% 44%, rgba(0,0,0,.55) 56%, transparent 70%);
      mask: radial-gradient(circle, transparent 0 27%, #000 31% 44%, rgba(0,0,0,.55) 56%, transparent 70%);
    }
    /* Brillo Doppler fijo: el lado que se acerca brilla en cian, el que se aleja cae a magenta */
    .disk-light {
      background: conic-gradient(from 200deg,
        #eafeff 0deg, var(--cyan) 55deg, var(--violet) 140deg, #2a0640 190deg,
        var(--magenta) 250deg, var(--cyan) 315deg, #eafeff 360deg);
    }
    .disk-streaks {
      background: repeating-conic-gradient(from 0deg,
        rgba(255,255,255,.0) 0deg 7deg, rgba(225,252,255,.4) 9deg, rgba(255,255,255,0) 12deg 19deg);
      mix-blend-mode: overlay;
      animation: spin 26s linear infinite;
    }
    .horizon {
      position: absolute; left: 50%; top: 50%; width: 42%; aspect-ratio: 1;
      transform: translate(-50%, -50%); border-radius: 50%;
      background: radial-gradient(circle at 50% 50%, #000 62%, #04020a 100%);
      box-shadow:
        0 0 0 1.5px rgba(190, 250, 255, 0.9),
        0 0 18px 3px rgba(0, 240, 255, 0.55),
        0 0 70px 14px rgba(255, 0, 255, 0.3);
    }
    /* Anillo de fotones: la luz que se curva sobre el horizonte */
    .lensing {
      position: absolute; left: 50%; top: 50%; width: 50%; aspect-ratio: 1;
      transform: translate(-50%, -50%) rotate(var(--tilt)); border-radius: 50%;
      background: conic-gradient(from 180deg, transparent 0deg, rgba(0,240,255,0) 70deg, rgba(150,248,255,.85) 160deg, rgba(235,254,255,1) 180deg, rgba(255,120,255,.8) 200deg, rgba(255,0,255,0) 290deg, transparent 360deg);
      -webkit-mask: radial-gradient(circle, transparent 0 84%, #000 87% 90%, transparent 97%);
      mask: radial-gradient(circle, transparent 0 84%, #000 87% 90%, transparent 97%);
      filter: blur(0.6px);
    }
    .disk.back { z-index: 1; } .horizon { z-index: 2; } .lensing { z-index: 3; } .disk.front { z-index: 4; }
    .hero.is-offscreen .disk-streaks { animation-play-state: paused; }

    @keyframes spin { to { transform: rotate(1turn); } }

    /* Secuencia de carga: el único momento orquestado de la página */
    @media (prefers-reduced-motion: no-preference) {
      .js .void { animation: ignite 1600ms var(--ease-out) 100ms both; }
      .js .hero h1 .line > span { animation: rise 900ms var(--ease-out) both; }
      .js .hero h1 .line:nth-child(1) > span { animation-delay: 260ms; }
      .js .hero h1 .line:nth-child(2) > span { animation-delay: 320ms; }
      .js .hero h1 .line:nth-child(3) > span { animation-delay: 380ms; }
      .js .hero-kicker, .js .hero .lede, .js .hero-actions, .js .highlights {
        animation: fade-up 700ms var(--ease-out) both;
      }
      .js .hero-kicker { animation-delay: 180ms; }
      .js .hero .lede { animation-delay: 520ms; }
      .js .hero-actions { animation-delay: 580ms; }
      .js .highlights { animation-delay: 640ms; }
      /* Aberración cromática que se asienta: el título "entra en foco" como la señal de A.N.A. */
      .js .hero h1 { animation: chroma 1400ms var(--ease-out) 260ms both; }
    }
    @keyframes chroma {
      0% { text-shadow: -10px 0 rgba(0,240,255,.9), 10px 0 rgba(255,0,255,.9); }
      60% { text-shadow: -2px 0 rgba(0,240,255,.6), 2px 0 rgba(255,0,255,.6); }
      100% { text-shadow: -1px 0 rgba(0,240,255,.35), 1px 0 rgba(255,0,255,.35); }
    }
    @keyframes ignite {
      from { opacity: 0; transform: scale(0.9) rotate(-6deg); }
      to { opacity: 1; transform: none; }
    }
    @keyframes rise { from { transform: translateY(105%); } to { transform: none; } }
    @keyframes fade-up { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

    @media (max-width: 860px) {
      .hero { padding-top: 104px; align-items: start; }
      .hero-grid { grid-template-columns: 1fr; }
      .void-stage { order: -1; max-width: 420px; width: 92%; margin-bottom: -8%; }
    }

    /* ---------- Secciones ---------- */
    .section { padding: clamp(72px, 10vw, 144px) 0; border-top: 1px solid var(--rule); }
    .section-head {
      display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between;
      gap: 16px 32px; margin-bottom: clamp(32px, 5vw, 56px);
    }
    .section-head p { max-width: 46ch; color: var(--dust); }

    /* Juegos */
    /* A.N.A. destacado: texto a la izquierda, el teléfono flotando a la derecha (sin caja detrás) */
    .feature {
      display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center;
      gap: clamp(24px, 4vw, 64px); margin-bottom: clamp(56px, 7vw, 96px);
    }
    .feature-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; min-width: 0; }
    .feature-award {
      display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--starlight);
      font-variation-settings: "wdth" 110;
    }
    .feature-award-mark { flex: none; width: 10px; height: 10px; transform: rotate(45deg); background: var(--grad); box-shadow: 0 0 10px rgba(255,0,255,.6); }
    /* Teléfono completo (sin recortes), flotando con reflejo de luz y halo de neón que respira */
    .feature-device { position: relative; aspect-ratio: 1200 / 1033; min-width: 0; }
    .device-glow {
      position: absolute; inset: 14% 10%; border-radius: 50%;
      background: radial-gradient(ellipse at 30% 60%, rgba(0,240,255,.42), transparent 60%),
                  radial-gradient(ellipse at 72% 40%, rgba(255,0,255,.48), transparent 60%);
      filter: blur(48px);
    }
    .device-tilt { position: absolute; inset: 0; will-change: transform; }
    .device-float { position: absolute; inset: 0; }
    .device {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain;
      filter: drop-shadow(0 40px 50px rgba(0,0,0,.65)) drop-shadow(0 0 30px rgba(255,0,255,.18));
    }
    /* El reflejo solo aparece sobre los píxeles del teléfono: usa la propia imagen como máscara */
    .device-glare {
      position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen;
      -webkit-mask: url("/assets/studio/ana-phone-1200.webp") center / contain no-repeat;
      mask: url("/assets/studio/ana-phone-1200.webp") center / contain no-repeat;
      background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,.22) 45%, rgba(0,240,255,.18) 50%, transparent 60%);
      background-size: 250% 100%; background-position: 150% 0; opacity: 0;
    }
    @media (prefers-reduced-motion: no-preference) {
      .feature.is-in .device-float { animation: device-float 7s var(--ease-in-out) infinite alternate; }
      .feature.is-in .device-glow { animation: glow-breathe 4s ease-in-out infinite alternate; }
      .feature.is-in .device-glare { animation: glare 6s var(--ease-in-out) 1.2s infinite; }
    }
    @keyframes device-float {
      0% { transform: translate3d(0, -12px, 0) rotate(-1.2deg); }
      100% { transform: translate3d(0, 12px, 0) rotate(1deg); }
    }
    @keyframes glow-breathe { from { opacity: .65; transform: scale(.96); } to { opacity: 1; transform: scale(1.04); } }
    @keyframes glare {
      0% { background-position: 150% 0; opacity: 0; }
      8% { opacity: 1; }
      35% { background-position: -50% 0; opacity: 1; }
      40%, 100% { background-position: -50% 0; opacity: 0; }
    }
    @media (max-width: 860px) {
      .feature { grid-template-columns: 1fr; }
      .feature-device { order: -1; }
    }

    /* Resto del catálogo: tarjetas iguales y alineadas fila a fila (subgrid) */
    .games { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 3vw, 40px) clamp(16px, 2vw, 24px); }
    .game {
      display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 16px; justify-items: start; min-width: 0;
    }
    .cover {
      position: relative; overflow: hidden; border-radius: 4px; background: var(--hull);
      aspect-ratio: 16 / 9; width: 100%;
    }
    @media (max-width: 720px) { .games { grid-template-columns: 1fr; } }
    /* Logo de A.N.A. con glitch RGB al aparecer y al pasar el cursor */
    .ana-logo { display: block; position: relative; width: clamp(240px, 28vw, 380px); max-width: 100%; aspect-ratio: 1162 / 468; margin: 4px 0 -4px; }
    .ana-logo img { position: absolute; inset: 0; width: 100%; height: 100%; mix-blend-mode: screen; filter: contrast(1.25); }
    .ana-logo .ghost { opacity: 0; }
    @media (prefers-reduced-motion: no-preference) {
      .ana-logo.is-glitching .ghost { animation: glitch-a 520ms steps(1) both; }
      .ana-logo.is-glitching .ghost + .ghost { animation-name: glitch-b; }
      .ana-logo.is-glitching .main { animation: glitch-main 520ms steps(1) both; }
    }
    @keyframes glitch-a {
      0% { opacity: .9; clip-path: inset(10% 0 62% 0); transform: translateX(-12px); }
      20% { clip-path: inset(48% 0 30% 0); transform: translateX(9px); }
      40% { clip-path: inset(70% 0 8% 0); transform: translateX(-6px); }
      60% { clip-path: inset(24% 0 55% 0); transform: translateX(5px); }
      80% { clip-path: inset(5% 0 80% 0); transform: translateX(-3px); }
      100% { opacity: 0; clip-path: inset(0); transform: none; }
    }
    @keyframes glitch-b {
      0% { opacity: .9; clip-path: inset(60% 0 15% 0); transform: translateX(10px); }
      25% { clip-path: inset(18% 0 66% 0); transform: translateX(-8px); }
      50% { clip-path: inset(40% 0 40% 0); transform: translateX(6px); }
      75% { clip-path: inset(80% 0 4% 0); transform: translateX(-4px); }
      100% { opacity: 0; clip-path: inset(0); transform: none; }
    }
    @keyframes glitch-main { 0%, 40% { opacity: .55; } 50% { opacity: 1; } 70% { opacity: .75; } 100% { opacity: 1; } }
    .cover img {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
      transition: transform 600ms var(--ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .game:hover .cover img { transform: scale(1.03); }
    }
    .game-title { font-size: var(--t-lg); font-weight: 800; font-variation-settings: "wdth" 120; line-height: 1.1; text-transform: uppercase; overflow-wrap: anywhere; }
    .game-sub { color: var(--starlight); font-weight: 600; margin-top: -8px; }
    .game-meta { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
      display: inline-flex; align-items: center; min-height: 28px; padding: 0 10px;
      border: 1px solid var(--rule); border-radius: 2px;
      font-size: var(--t-sm); font-weight: 600; color: var(--dust);
    }
    .tag--date { color: var(--void); background: var(--photon); border-color: var(--photon); }
    .game-desc { color: var(--dust); max-width: 52ch; }

    @media (prefers-reduced-motion: no-preference) {
      .js .cover.reveal { clip-path: inset(0 0 100% 0); }
      .js .cover.reveal.is-in { clip-path: inset(0 0 0 0); transition: clip-path 1100ms var(--ease-in-out); }
    }


    /* Premios: final global y semifinal con el mismo protagonismo, cada uno en su escenario de neón */
    .trophies { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 3vw, 40px); }
    .trophy-card { display: grid; grid-template-rows: auto auto auto 1fr; gap: 12px; align-content: start; min-width: 0; }
    .trophy-stage {
      position: relative; margin: 0 0 8px; height: clamp(380px, 42vw, 600px); border-radius: 6px; overflow: hidden;
      background:
        radial-gradient(ellipse at 50% 40%, rgba(255, 0, 255, .16), transparent 60%),
        radial-gradient(ellipse at 50% 90%, rgba(0, 240, 255, .14), transparent 55%),
        linear-gradient(180deg, #08080c, #050505);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
    }
    .trophy-glow {
      position: absolute; left: 50%; top: 46%; width: 62%; aspect-ratio: 1; margin: -31% 0 0 -31%;
      border-radius: 50%; background: conic-gradient(from 0deg, rgba(0,240,255,.5), rgba(255,0,255,.5), rgba(122,28,255,.4), rgba(0,240,255,.5));
      filter: blur(70px); opacity: .55;
    }
    .trophy-ring {
      position: absolute; left: 19%; right: 19%; bottom: 7%; aspect-ratio: 1; transform: scaleY(.18);
      transform-origin: 50% 100%; border-radius: 50%;
      background: conic-gradient(from 0deg, transparent, rgba(0,240,255,.9) 25%, transparent 50%, rgba(255,0,255,.9) 75%, transparent);
      -webkit-mask: radial-gradient(circle, transparent 0 64%, #000 66% 70%, transparent 72%);
      mask: radial-gradient(circle, transparent 0 64%, #000 66% 70%, transparent 72%);
    }
    @media (prefers-reduced-motion: no-preference) {
      .trophy-glow { animation: spin 14s linear infinite; }
      .trophy-ring { animation: ring-spin 6s linear infinite; }
      .badge-float { animation: trophy-bob 5s var(--ease-in-out) infinite alternate; }
      .badge-shine { animation: glare 5s var(--ease-in-out) 1s infinite; }
    }
    @keyframes ring-spin { from { transform: scaleY(.18) rotate(0deg); } to { transform: scaleY(.18) rotate(1turn); } }
    @keyframes trophy-bob { from { transform: translate3d(0, -10px, 0) rotate(-1deg); } to { transform: translate3d(0, 10px, 0) rotate(1deg); } }

    /* Insignia de la final global: grande, flotando, con un destello que recorre solo la insignia */
    .badge-float { position: absolute; inset: 8% 6% 14%; }
    .badge { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 0 24px rgba(0,240,255,.25)); }
    .badge-shine {
      position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; opacity: 0;
      -webkit-mask: url("/assets/studio/premio-latam.webp") center / contain no-repeat;
      mask: url("/assets/studio/premio-latam.webp") center / contain no-repeat;
      background: linear-gradient(115deg, transparent 35%, rgba(255,255,255,.7) 45%, rgba(255,0,255,.5) 52%, transparent 62%);
      background-size: 250% 100%; background-position: 150% 0;
    }

    /* Placa de la semifinal en 3D (three.js); la foto queda de respaldo si WebGL no está disponible */
    .trophy-poster { position: absolute; inset: 6%; width: 88%; height: 88%; object-fit: contain; transition: opacity 400ms ease; }
    .trophy-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 600ms ease; cursor: grab; touch-action: pan-y; }
    .trophy-canvas:active { cursor: grabbing; }
    .trophy-stage--3d.is-3d .trophy-canvas { opacity: 1; }
    .trophy-stage--3d.is-3d .trophy-poster { opacity: 0; }
    .model-hint { position: absolute; left: 16px; bottom: 14px; pointer-events: none; font-size: var(--t-sm); color: var(--dust); opacity: 0; transition: opacity 400ms ease; }
    .trophy-stage--3d.is-3d .model-hint { opacity: 1; }

    .trophy-card h3 { font-size: var(--t-lg); font-weight: 800; font-variation-settings: "wdth" 118; line-height: 1.15; text-wrap: balance; }
    .award-event { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; font-weight: 800; font-size: var(--t-sm); width: fit-content; }
    .award-desc { color: var(--dust); max-width: 52ch; }
    @media (max-width: 860px) { .trophies { grid-template-columns: 1fr; } }

    /* Equipo */
    .team { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(28px, 3vw, 40px) clamp(16px, 2vw, 24px); }
    .member { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    /* Retratos unificados: monocromo con tinte cian/magenta; a color al pasar el cursor */
    .member-frame {
      position: relative; aspect-ratio: 4 / 5; border-radius: 4px; overflow: hidden; background: var(--hull);
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.06);
    }
    .member-photo {
      width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%;
      filter: grayscale(1) contrast(1.08) brightness(.92);
      transition: filter 500ms ease, transform 700ms var(--ease-out);
    }
    .member-frame::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(160deg, rgba(0,240,255,.32), rgba(5,5,5,0) 45%, rgba(255,0,255,.38));
      mix-blend-mode: color; transition: opacity 500ms ease;
    }
    .member-frame::before {
      content: ""; position: absolute; inset: auto 0 0 0; height: 40%; z-index: 1; pointer-events: none;
      background: linear-gradient(to top, rgba(5,5,5,.7), transparent);
    }
    @media (hover: hover) and (pointer: fine) {
      .member:hover .member-photo { filter: none; transform: scale(1.03); }
      .member:hover .member-frame::after { opacity: 0; }
    }
    .member-name { font-size: var(--t-md); font-weight: 800; font-variation-settings: "wdth" 112; line-height: 1.2; overflow-wrap: anywhere; }
    .member-handle { color: var(--cyan); font-size: var(--t-sm); font-weight: 600; overflow-wrap: anywhere; }
    .member-role { color: var(--dust); font-size: var(--t-sm); text-wrap: pretty; }
    .member--lead { grid-column: span 2; grid-row: span 2; }
    .member--lead .member-frame { aspect-ratio: auto; flex: 1; min-height: 420px; }
    .member--lead .member-name { font-size: var(--t-lg); }
    @media (max-width: 1080px) { .team { grid-template-columns: repeat(3, minmax(0, 1fr)); } .member--lead { grid-column: span 3; grid-row: auto; } .member--lead .member-frame { aspect-ratio: 16 / 10; flex: none; min-height: 0; } }
    @media (max-width: 720px) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); } .member--lead { grid-column: span 2; } }

    /* Tienda */
    .products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(24px, 2.5vw, 32px) clamp(16px, 2vw, 24px); }
    /* Cada tarjeta ocupa 6 filas compartidas: foto, nombre, descripción, precio, opciones y botón quedan alineados */
    .product { display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: 12px; align-content: start; min-width: 0; }
    .product-options { align-self: start; }
    .sizes-field { border: 0; padding: 0; margin: 0; min-width: 0; }
    .option-note { color: var(--dust); font-size: var(--t-sm); padding-top: 22px; }
    .tag--soldout { background: rgba(5,5,5,.85); color: var(--starlight); border-color: #3f3f46; }
    .product-figure { position: relative; aspect-ratio: 1; border-radius: 4px; overflow: hidden; background: var(--hull); }
    .product-figure img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out); }
    @media (hover: hover) and (pointer: fine) { .product:hover .product-figure img { transform: scale(1.03); } }
    .product--soldout .product-figure img { opacity: 0.45; filter: grayscale(0.6); }
    .product-badge { position: absolute; top: 12px; left: 12px; }
    .product-name { font-size: var(--t-md); font-weight: 800; font-variation-settings: "wdth" 112; line-height: 1.2; overflow-wrap: anywhere; }
    .product-desc { color: var(--dust); font-size: var(--t-sm); }
    .price { display: flex; align-items: baseline; gap: 10px; font-variant-numeric: tabular-nums; }
    .price-now { font-size: var(--t-md); font-weight: 800; }
    .price-was { color: var(--dust); text-decoration: line-through; font-size: var(--t-sm); }
    .product-options { display: grid; gap: 12px; border: 0; padding: 0; margin: 0; min-width: 0; }
    .option-label { font-size: var(--t-sm); color: var(--dust); margin-bottom: 6px; display: block; padding: 0; }
    .sizes { display: flex; flex-wrap: wrap; gap: 6px; }
    .size { position: relative; }
    .size input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
    .size span {
      display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 0 10px;
      border: 1px solid #3a3d45; border-radius: 2px; font-weight: 700; font-size: var(--t-sm);
      transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
    }
    .size input:checked + span { background: var(--starlight); color: var(--void); border-color: var(--starlight); }
    .size input:focus-visible + span { outline: 2px solid var(--photon); outline-offset: 2px; }
    @media (hover: hover) and (pointer: fine) { .size input:not(:checked):hover + span { border-color: var(--starlight); } }
    .qty select {
      min-height: 44px; min-width: 88px; padding: 0 12px; font: inherit; font-weight: 600;
      color: var(--starlight); background-color: var(--hull); border: 1px solid #3a3d45; border-radius: 2px;
    }
    .product .btn { width: 100%; align-self: end; }
    .product .btn-label { transition: filter 200ms ease, opacity 200ms ease; }
    .product .btn.is-added .btn-label { animation: label-swap 360ms var(--ease-out); }
    @keyframes label-swap { from { filter: blur(3px); opacity: .3; } to { filter: none; opacity: 1; } }
    .btn[disabled] { opacity: 0.5; cursor: not-allowed; transform: none; }
    @media (max-width: 1080px) { .products { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 520px) { .products { grid-template-columns: 1fr; } }

    /* Carrito */
    .nav-actions { display: flex; align-items: center; gap: 8px; }
    .cart-button {
      position: relative; display: inline-grid; place-items: center; width: 44px; height: 44px;
      color: var(--starlight); background: transparent; border: 1px solid #3f3f46; border-radius: 2px; cursor: pointer;
      transition: border-color 200ms ease, transform 160ms var(--ease-out);
    }
    .cart-button:active { transform: scale(0.95); }
    @media (hover: hover) and (pointer: fine) { .cart-button:hover { border-color: var(--cyan); } }
    .cart-count {
      position: absolute; top: -7px; right: -7px; min-width: 20px; height: 20px; padding: 0 5px;
      display: grid; place-items: center; border-radius: 10px;
      background: var(--grad); color: #050505; font-size: 12px; font-weight: 800; font-variant-numeric: tabular-nums;
      transform: scale(0); transition: transform 240ms var(--ease-out);
    }
    .cart-button[data-count]:not([data-count="0"]) .cart-count { transform: scale(1); }
    @media (prefers-reduced-motion: no-preference) {
      .cart-count.is-bump { animation: bump 420ms var(--ease-out); }
    }
    @keyframes bump { 0% { transform: scale(1); } 35% { transform: scale(1.35); } 100% { transform: scale(1); } }

    .cart-overlay {
      position: fixed; inset: 0; z-index: 80; background: rgba(0,0,0,.6);
      opacity: 0; visibility: hidden; transition: opacity 200ms ease, visibility 0s linear 200ms;
    }
    .cart-overlay[data-open="true"] { opacity: 1; visibility: visible; transition: opacity 300ms ease, visibility 0s; }
    .cart {
      position: fixed; top: 0; right: 0; bottom: 0; z-index: 90; width: min(440px, 100%);
      display: grid; grid-template-rows: auto minmax(0, 1fr) auto;
      background: #08080b; border-left: 1px solid var(--rule);
      box-shadow: -30px 0 80px rgba(0,0,0,.6);
      padding-bottom: env(safe-area-inset-bottom);
      transform: translateX(100%); visibility: hidden;
      transition: transform 220ms var(--ease-out), visibility 0s linear 220ms;
    }
    .cart[data-open="true"] { transform: none; visibility: visible; transition: transform 380ms var(--ease-drawer), visibility 0s; }
    .cart-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--rule); }
    .cart-title { font-size: var(--t-md); font-weight: 800; font-variation-settings: "wdth" 120; text-transform: uppercase; }
    .cart-close {
      display: grid; place-items: center; width: 44px; height: 44px; color: var(--starlight);
      background: transparent; border: 1px solid transparent; border-radius: 2px; cursor: pointer;
    }
    @media (hover: hover) and (pointer: fine) { .cart-close:hover { border-color: #3f3f46; } }
    .cart-body { overflow-y: auto; overscroll-behavior: contain; padding: 8px 20px 20px; }
    .cart-items { display: grid; }
    .cart-item { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--rule); align-items: start; }
    .cart-item img { width: 72px; height: 72px; object-fit: cover; border-radius: 4px; background: var(--hull); }
    .cart-item-name { font-weight: 700; line-height: 1.3; overflow-wrap: anywhere; }
    .cart-item-meta { color: var(--dust); font-size: var(--t-sm); }
    .cart-item-price { font-weight: 800; font-variant-numeric: tabular-nums; text-align: right; }
    .stepper { display: inline-flex; align-items: center; margin-top: 10px; border: 1px solid #3f3f46; border-radius: 2px; }
    .stepper button {
      width: 36px; height: 36px; display: grid; place-items: center; font: inherit; font-weight: 700;
      color: var(--starlight); background: transparent; border: 0; cursor: pointer;
    }
    .stepper output { min-width: 28px; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
    .cart-remove {
      display: block; margin-top: 8px; margin-left: auto; padding: 4px 0; min-height: 32px; font: inherit; font-size: var(--t-sm);
      color: var(--dust); background: none; border: 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer;
    }
    @media (hover: hover) and (pointer: fine) { .cart-remove:hover { color: var(--starlight); } .stepper button:hover { color: var(--cyan); } }
    .cart-empty, .checkout, .cart-done { display: none; }
    .cart-empty { padding: 40px 0; gap: 20px; justify-items: start; color: var(--dust); }
