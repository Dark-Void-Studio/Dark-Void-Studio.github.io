      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 24px; }
    .brand { display: block; width: 164px; flex: none; border-radius: 2px; }
    .brand-crop { display: block; aspect-ratio: 725 / 84; overflow: hidden; }
    .brand-crop img { width: 110.07%; height: auto; max-width: none; margin-left: -4.83%; margin-top: -8.1%; mix-blend-mode: screen; }
    .nav-links { display: flex; align-items: center; gap: 4px; }
    .nav-links a {
      display: inline-flex; align-items: center; min-height: 44px; padding: 0 14px;
      text-decoration: none; font-weight: 600; color: var(--dust);
      transition: color 200ms ease;
    }
    .nav-links a:focus-visible { color: var(--starlight); }
    @media (hover: hover) and (pointer: fine) { .nav-links a:hover { color: var(--starlight); } }
    .nav-cta { min-height: 44px; padding: 0 18px; }
    .menu-toggle { display: none; }

    @media (max-width: 860px) {
      .nav-links, .nav .nav-cta { display: none; }
      .menu-toggle {
        display: inline-flex; min-height: 44px; padding: 0 16px;
        background: transparent; color: var(--starlight); border-color: #4a4d56;
      }
    }

    .mobile-menu {
      position: fixed; inset: 72px 0 auto 0; z-index: 49;
      background: var(--void); border-bottom: 1px solid var(--rule);
      padding: 8px max(var(--gutter), env(safe-area-inset-right)) 24px max(var(--gutter), env(safe-area-inset-left));
      max-height: calc(100svh - 72px); overflow-y: auto; overscroll-behavior: contain;
