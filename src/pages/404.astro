---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Página no encontrada | Darkvoid Studios"
  description="Esta señal se perdió en el vacío. Volvé al inicio de Darkvoid Studios."
>
  <main class="wrap-404">
    <p class="eyebrow-404">ERROR 404 · SIGNAL LOST_</p>
    <h1 class="title-404">Esta página se perdió en el vacío</h1>
    <p class="desc-404">El link que seguiste ya no existe o fue movido.</p>
    <a class="btn-404" href="/">← VOLVER AL INICIO</a>
  </main>

  <style>
    .wrap-404 { max-width: 640px; margin: 0 auto; padding: 80px 20px; text-align: center; background: #050505; color: #f5f5f7; font-family: "Archivo", system-ui, sans-serif; }
    .eyebrow-404 { font-size: 0.8rem; letter-spacing: 0.12em; color: #00f0ff; }
    .title-404 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; text-transform: uppercase; line-height: 1; }
    .desc-404 { color: #9ca3af; }
    .btn-404 {
      display: inline-block; margin-top: 18px; padding: 12px 24px; min-height: 48px;
      background: linear-gradient(135deg, #00f0ff 0%, #ff00ff 100%); color: #050505; border-radius: 2px;
      font-weight: 700; text-decoration: none;
    }
  </style>
</Layout>
